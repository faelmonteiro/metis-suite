#!/usr/bin/env bash
# =============================================================================
# METIS AI - CLI WRAPPER (FIXED)
# =============================================================================

# Raiz do código Python
METIS_ROOT="${METIS_ROOT:-$HOME/Metis}"
if [ ! -f "$METIS_ROOT/app.py" ] && [ -f "$HOME/.local/share/metis/app/app.py" ]; then
    METIS_ROOT="$HOME/.local/share/metis"
fi

# O venv chama-se .venv no projeto local e venv na cópia de distribuição
PYTHON_BIN=""
for _metis_cand in "$METIS_ROOT/.venv" "$METIS_ROOT/venv" "$HOME/Metis/.venv" "$HOME/.local/share/metis/.venv" "$HOME/.local/share/metis/venv"; do
    if [ -x "$_metis_cand/bin/python" ]; then
        PYTHON_BIN="$_metis_cand/bin/python"
        break
    fi
done
unset _metis_cand
[ -n "$PYTHON_BIN" ] || PYTHON_BIN="python3"

# Use the correct app.py path
if [ -f "$METIS_ROOT/app/app.py" ]; then
    APP_PY="$METIS_ROOT/app/app.py"
elif [ -f "$METIS_ROOT/app.py" ]; then
    APP_PY="$METIS_ROOT/app.py"
else
    APP_PY="$HOME/.local/share/metis/app/app.py"
fi

export PYTHONPATH="$METIS_ROOT:$PYTHONPATH"

# Módulos ZSH
METIS_ZSH="${METIS_ZSH:-$HOME/.ZSH/ai}"
[ -f "$METIS_ZSH/loader.zsh" ] || METIS_ZSH="$HOME/.local/share/metis/zsh"

# update/uninstall
METIS_SCRIPTS="${METIS_SCRIPTS:-$HOME/metis-suite}"
[ -f "$METIS_SCRIPTS/update.sh" ] || METIS_SCRIPTS="$HOME/.local/share/metis"

# Roteamento de comandos
if [ "$1" = "gui" ]; then
    shift
    exec "$PYTHON_BIN" "$METIS_ROOT/gui.py" "$@"
elif [ "$1" = "vision" ] || [ "$1" = "screenai" ]; then
    shift
    exec "$METIS_ROOT/vision/run.sh" "$@"
elif [ "$1" = "explain" ] || [ "$1" = "screen" ]; then
    shift
    if [ "$1" = "screen" ] || [ "$1" = "explain" ] || [ "$1" = "tela" ]; then
        shift
    fi
    if command -v metis-screen >/dev/null 2>&1; then
        exec metis-screen "$@"
    elif [ -x "$HOME/.local/bin/metis-screen" ]; then
        exec "$HOME/.local/bin/metis-screen" "$@"
    elif [ -x "/usr/local/bin/metis-screen" ]; then
        exec "/usr/local/bin/metis-screen" "$@"
    elif [ -x "$METIS_ROOT/vision/run.sh" ]; then
        exec "$METIS_ROOT/vision/run.sh" "$@"
    else
        exec "$PYTHON_BIN" "$APP_PY" "$@"
    fi
elif [ "$1" = "fix" ] || [ "$1" = "menu" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_ZSH/loader.zsh" ]; then
        exec zsh -c "source '$METIS_ZSH/loader.zsh' 2>/dev/null; inteligencia_prompt"
    else
        echo "💡 ZSH não instalado. Iniciando menu interativo Metis..." >&2
        exec "$PYTHON_BIN" "$APP_PY" "$@"
    fi
elif [ "$1" = "aiman" ] || [ "$1" = "man" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_ZSH/loader.zsh" ]; then
        exec zsh -c 'source "$1/loader.zsh" 2>/dev/null; shift; aiman "$@"' _ "$METIS_ZSH" "$@"
    else
        exec "$PYTHON_BIN" "$APP_PY" --help "$@"
    fi
elif [ "$1" = "commit" ] || [ "$1" = "gca" ] || [ "$1" = "git" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_ZSH/loader.zsh" ]; then
        exec zsh -c 'source "$1/loader.zsh" 2>/dev/null; shift; git_commit_ai "$@"' _ "$METIS_ZSH" "$@"
    else
        echo "⚠️  O ZSH é necessário para executar o git-ai." >&2
        exit 1
    fi
elif [ "$1" = "history" ] || [ "$1" = "iah" ]; then
    shift
    HIST_FILE="${HOME}/.zsh_ai_history"
    if [ ! -f "$HIST_FILE" ]; then
        echo "Histórico de IA ainda está vazio."
        exit 0
    fi
    if command -v fzf >/dev/null 2>&1; then
        tac "$HIST_FILE" | sed 's/^: [0-9]*:[0-9]*;//' | awk '!seen[$0]++' | fzf --height 40% --reverse --prompt="🤖 Histórico de IA & Prompts > "
    else
        tail -n 20 "$HIST_FILE" | sed 's/^: [0-9]*:[0-9]*;//'
    fi
elif [ "$1" = "uninstall" ]; then
    exec "$METIS_SCRIPTS/uninstall.sh"
elif [ "$1" = "update" ] || [ "$1" = "--update" ] || [ "$1" = "-u" ]; then
    exec "$METIS_SCRIPTS/update.sh"
else
    exec "$PYTHON_BIN" "$APP_PY" "$@"
fi
