#!/usr/bin/env bash
# =============================================================================
# METIS AI - CLI WRAPPER
# =============================================================================

METIS_INSTALL_DIR="${METIS_INSTALL_DIR:-$HOME/.local/share/metis}"
PYTHON_BIN="$METIS_INSTALL_DIR/venv/bin/python3"

if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="$METIS_INSTALL_DIR/venv/bin/python"
fi
if [ ! -f "$PYTHON_BIN" ] && [ -f "$HOME/.local/share/metis/venv/bin/python" ]; then
    PYTHON_BIN="$HOME/.local/share/metis/venv/bin/python"
fi
if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="python3"
fi

export PYTHONPATH="$METIS_INSTALL_DIR/app:$PYTHONPATH"

# Roteamento de comandos
if [ "$1" = "gui" ]; then
    shift
    exec "$PYTHON_BIN" "$METIS_INSTALL_DIR/app/gui.py" "$@"
elif [ "$1" = "vision" ] || [ "$1" = "screenai" ]; then
    shift
    exec "$METIS_INSTALL_DIR/app/vision/run.sh" "$@"
elif [ "$1" = "explain" ] || [ "$1" = "screen" ]; then
    shift
    if [ "$1" = "screen" ] || [ "$1" = "explain" ] || [ "$1" = "tela" ]; then
        shift
    fi
    if command -v metis-screen >/dev/null 2>&1; then
        exec metis-screen "$@"
    elif [ -x "$HOME/.local/bin/metis-screen" ]; then
        exec "$HOME/.local/bin/metis-screen" "$@"
    elif [ -x "/usr/local/bin/metis-screen" ]; then
        exec "/usr/local/bin/metis-screen" "$@"
    elif [ -x "$METIS_INSTALL_DIR/app/vision/run.sh" ]; then
        exec "$METIS_INSTALL_DIR/app/vision/run.sh" "$@"
    elif command -v zsh >/dev/null 2>&1 && [ -f "$METIS_INSTALL_DIR/zsh/explain_screen.zsh" ]; then
        exec zsh "$METIS_INSTALL_DIR/zsh/explain_screen.zsh" "$@"
    else
        exec "$PYTHON_BIN" "$METIS_INSTALL_DIR/app/app.py" "$@"
    fi
elif [ "$1" = "fix" ] || [ "$1" = "menu" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_INSTALL_DIR/zsh/loader.zsh" ]; then
        exec zsh -c "source '$METIS_INSTALL_DIR/zsh/loader.zsh' 2>/dev/null; inteligencia_prompt"
    else
        echo "💡 ZSH não instalado. Iniciando menu interativo Metis..." >&2
        exec "$PYTHON_BIN" "$METIS_INSTALL_DIR/app/app.py" "$@"
    fi
elif [ "$1" = "aiman" ] || [ "$1" = "man" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_INSTALL_DIR/zsh/loader.zsh" ]; then
        exec zsh -c 'METIS_DIR="$1"; shift; source "$METIS_DIR/zsh/loader.zsh" 2>/dev/null; aiman "$@"' _ "$METIS_INSTALL_DIR" "$@"
    else
        exec "$PYTHON_BIN" "$METIS_INSTALL_DIR/app/app.py" --help "$@"
    fi
elif [ "$1" = "commit" ] || [ "$1" = "gca" ] || [ "$1" = "git" ]; then
    shift
    if command -v zsh >/dev/null 2>&1 && [ -f "$METIS_INSTALL_DIR/zsh/loader.zsh" ]; then
        exec zsh -c 'METIS_DIR="$1"; shift; source "$METIS_DIR/zsh/loader.zsh" 2>/dev/null; git_commit_ai "$@"' _ "$METIS_INSTALL_DIR" "$@"
    else
        echo "⚠️  O ZSH é necessário para executar o git-ai." >&2
        exit 1
    fi
elif [ "$1" = "history" ] || [ "$1" = "iah" ]; then
    shift
    HIST_FILE="${HOME}/.zsh_ai_history"
    if [ ! -f "$HIST_FILE" ]; then
        echo "Histórico de IA ainda está vazio."
        exit 0
    fi
    if command -v fzf >/dev/null 2>&1; then
        tac "$HIST_FILE" | sed 's/^: [0-9]*:[0-9]*;//' | awk '!seen[$0]++' | fzf --height 40% --reverse --prompt="🤖 Histórico de IA & Prompts > "
    else
        tail -n 20 "$HIST_FILE" | sed 's/^: [0-9]*:[0-9]*;//'
    fi
elif [ "$1" = "uninstall" ]; then
    exec "$METIS_INSTALL_DIR/uninstall.sh"
elif [ "$1" = "update" ] || [ "$1" = "--update" ] || [ "$1" = "-u" ]; then
    exec "$METIS_INSTALL_DIR/update.sh"
else
    exec "$PYTHON_BIN" "$METIS_INSTALL_DIR/app/app.py" "$@"
fi
