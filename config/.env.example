# =============================================================================
# METIS AI SUITE - CONFIGURAÇÃO DE AMBIENTE (.env)
# =============================================================================

# Chaves de API das Provedoras em Nuvem
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Provedor Ativo Inicial (gemini, groq, nvidia, openrouter, ollama, g4f)
DEFAULT_PROVIDER=

# Modelos Padrão (Deixe em branco para escolher via Ctrl+G / metis)
GEMINI_MODEL=
GROQ_MODEL=
NVIDIA_MODEL=
OPENROUTER_MODEL=
OLLAMA_MODEL=
G4F_MODEL=

# Configurações do Ollama Local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.7

# Configurações do SearXNG (Busca Web)
SEARXNG_URL=http://127.0.0.1:8080
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=15
FETCH_PAGE_CONTENT=1

# Parâmetros Gerais
API_TIMEOUT=30
MAX_HISTORY_MESSAGES=20
MAX_WEB_CONTENT_CHARS=3000
NO_COLOR=0
LOG_LEVEL=WARNING
